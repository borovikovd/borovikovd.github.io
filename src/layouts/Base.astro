---
import '../styles/global.css';
import { SITE, LINKS } from '../consts';

interface Props {
  title?: string;
  description?: string;
  article?: { published: Date };
}

const { title, description = SITE.description, article } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@denis_bvk" />

    <script is:inline>
      const t = localStorage.getItem('theme');
      if (t) document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <header class="wrap">
      <div class="site-header">
        <a href="/" class="wordmark display">Denis Borovikov</a>
        <nav aria-label="Main" class="mono">
          <a href="/posts/">Writing</a>
          <a href="/rss.xml">RSS</a>
          <button id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
              <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6" />
              <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap">
      <div class="site-footer mono">
        <span>Q.E.D.</span>
        <ul>
          {LINKS.map((l) => <li><a href={l.href} rel="me">{l.label}</a></li>)}
          <li>© {year} Denis Borovikov</li>
        </ul>
      </div>
    </footer>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem 1.1rem;
    border-bottom: 1px solid var(--ink);
  }
  .wordmark { font-size: 1.5rem; text-decoration: none; }
  nav { display: flex; align-items: center; gap: 2rem; }
  nav a { text-decoration: none; }
  #theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin: -0.5rem -0.5rem -0.5rem -0.75rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  #theme-toggle:hover { color: var(--red); }

  main { flex: 1; }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 3rem;
    padding-block: 1.1rem 1.75rem;
    border-top: 1px solid var(--ink);
    color: var(--muted);
  }
  .site-footer ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 0; padding: 0; list-style: none; }
  .site-footer a { text-decoration: none; }
</style>
